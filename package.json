{
  "name": "sketch-social",
  "private": true,
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -k \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "start": "npm start -w server",
    "test": "npm test -w server",
    "load": "node scripts/load.mjs",
    "format": "prettier --write package.json client/package.json server/package.json \"client/src/*\" \"client/*.js\" \"server/src/*.js\" \"server/test/*.js\" \"scripts/*.mjs\""
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "prettier": "^3.9.10"
  }
}
